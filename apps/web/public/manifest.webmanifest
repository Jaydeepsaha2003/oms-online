{
  "name": "OMS — Order Management",
  "short_name": "OMS",
  "description": "Orders, dispatch, challans and follow-ups for the workshop — in one place.",
  "id": "/oms/",
  "start_url": "/oms/",
  "scope": "/oms/",
  "display": "standalone",
  "launch_handler": { "client_mode": "focus-existing" },
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#1e40af",
  "lang": "en",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/oms/icons/icon-192-v4.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/oms/icons/icon-512-v4.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/oms/icons/icon-maskable-512-v4.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Follow-ups", "url": "/oms/crm", "icons": [{ "src": "/oms/icons/icon-192-v4.png", "sizes": "192x192" }] },
    { "name": "New Order", "url": "/oms/orders/new", "icons": [{ "src": "/oms/icons/icon-192-v4.png", "sizes": "192x192" }] },
    { "name": "View Orders", "url": "/oms/orders", "icons": [{ "src": "/oms/icons/icon-192-v4.png", "sizes": "192x192" }] }
  ]
}
