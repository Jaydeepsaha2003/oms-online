// OMS data model — SQLite.
// Run `npm run db:migrate` to create/update tables, `npm run db:seed` to load
// the permission catalog, system roles and the bootstrap admin user.
//
// SQLite notes (vs MySQL/Postgres): no native enums, no Json type, no native
// type attributes (@db.Text). So `status` is a validated String, `metadata` /
// `Setting.value` hold JSON-serialized strings. To move to MySQL/Postgres later:
// change the provider below, restore an enum for status and `Json` columns, and
// re-migrate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Identity & access control ───────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  // Optional 4–6 digit quick-login PIN (bcrypt-hashed). Null = PIN login disabled.
  pinHash      String?
  // One of: 'active' | 'disabled' | 'invited' (enforced by the API via class-validator).
  status       String    @default("active")
  // Bumping tokenVersion invalidates every outstanding access token for the user.
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roles             UserRole[]
  refreshTokens     RefreshToken[]
  pushSubscriptions PushSubscription[]
  auditLogs         AuditLog[]

  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  // Stable machine name, e.g. 'super_admin'.
  name        String   @unique
  label       String
  description String?
  // System roles cannot be deleted from the UI.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(cuid())
  // Permission key, e.g. 'order:create'.
  key       String   @unique
  resource  String
  action    String
  label     String
  group     String
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

// Explicit join: User <-> Role (kept explicit so we can add assignedAt/assignedBy later).
model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// Explicit join: Role <-> Permission.
model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Hashed refresh tokens enable rotation + server-side revocation (logout / "log out everywhere").
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// One row per device's Web Push subscription — lets a broadcast reach a
// device even when the app is fully closed.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ── Audit trail: who did what, when, from where ─────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userEmail   String?
  action      String
  resource    String
  resourceId  String?
  description String?
  method      String?
  path        String?
  statusCode  Int?
  ip          String?
  userAgent   String?
  // JSON-serialized before/after snapshot (SQLite has no native Json type).
  metadata    String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resource])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── App settings (key/value, surfaced on the Settings screen) ───────────────

model Setting {
  key       String   @id
  // JSON-serialized value (SQLite has no native Json type).
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ── Sales: Customers & Transporters ─────────────────────────────────────────

model Transporter {
  // Integer PK to match the legacy TID and ease data import.
  id        Int      @id @default(autoincrement())
  // Auto-generated human-readable code (e.g. TRN-00001). Set by the API on create;
  // never required on import (it is derived server-side), shown on export.
  code      String?  @unique
  name      String   @unique
  packing   Float?
  freight   Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers  Customer[]
  transRates TransRate[]

  @@map("transporters")
}

// Sales agents (used when partySource = AGENT). Maintained as its own master so
// agents can be added on the fly from the customer form and tracked with timestamps.
model Agent {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  contactNo String?
  state     String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissionRates AgentCommissionRate[]
  specialRates    AgentSpecialCommission[]
  accruals        AgentCommissionAccrual[]
  covers          AgentPartyCover[]
  settlements     AgentSettlement[]
  cheques         Cheque[]

  @@map("agents")
}

model Customer {
  // Integer PK to match the legacy CUSTOMER.ID and ease data import.
  id            Int      @id @default(autoincrement())
  // Auto-generated human-readable code (e.g. CUST-00001). Set by the API on create;
  // never required on import (it is derived server-side), shown on export.
  code          String?  @unique
  partySource   String?
  agentName     String?
  category      String?
  partyName     String?
  billingRate   Float?
  // FK to Transporter; transportName/packing/freight are kept as a snapshot too
  // (the legacy form stored them on the customer row).
  transporterId Int?
  transportName String?
  bagName       String?
  packing       Float?
  freight       Float?
  boxRate       Int?
  creditPeriod  Int?
  city          String?
  state         String?
  region        String?
  mobile        String?
  email         String?
  brand         String?
  billRatePc    Float?
  payBy         String?
  // TDS: whether tax is deducted at source for this customer, and at what %.
  tdsApplicable Boolean  @default(false)
  tdsPercent    Float?
  // Active parties show in every picker; inactive ones are hidden from dropdowns
  // (but kept for history + visible on the Customers master via a status filter).
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transporter      Transporter?              @relation(fields: [transporterId], references: [id], onDelete: SetNull)
  gstRates         GstRate[]
  transRates       TransRate[]
  rateOverrides    CustomerRate[]
  logoRestrictions CustomerLogoRestriction[]
  bagWeights       CustomerBagWeight[]

  @@index([partyName])
  @@index([agentName])
  @@index([category])
  @@index([transporterId])
  @@map("customers")
}

// ── Customer "Special Rates" (legacy Form10) ──────────────────────────────────
// A per-customer rate DELTA added on top of the base product / design rate. The
// effective rate is resolved most-specific-first (ITEM → SUBCATEGORY → CATEGORY);
// only the first matching level applies. Replaces the 6 legacy tables
// (SPRODUCT/SCSPRODUCT/SCPRODUCT for products, SDESIGN/SCSDESIGN/SCDESIGN for
// designs) with one table keyed by (kind, scope). Unused levels are stored as ''
// (not null) so the composite unique key works on SQLite.
model CustomerRate {
  id          Int      @id @default(autoincrement())
  customerId  Int
  // 'PRODUCT' (adjusts the product rate) or 'DESIGN' (adjusts the design rate).
  kind        String
  // 'CATEGORY' | 'SUBCATEGORY' | 'ITEM' (specificity level).
  scope       String
  category    String
  subCategory String   @default("") // '' when scope = CATEGORY
  // Product name (kind PRODUCT) or design type (kind DESIGN); '' unless scope = ITEM.
  target      String   @default("")
  // Rate delta — may be negative (a discount).
  rate        Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, kind, scope, category, subCategory, target])
  @@index([customerId])
  @@map("customer_rates")
}

// Per-customer bag weight: for this customer + product category, one bag weighs
// `kgsPerBag` kgs. The order form auto-fills Kgs = Bags × kgsPerBag as bags are typed.
model CustomerBagWeight {
  id                 Int      @id @default(autoincrement())
  customerId         Int
  category           String
  kgsPerBag          Float
  // Max bags a non-admin may dispatch in one go for this customer + category.
  // Null = no party-specific limit (falls back to the global default in
  // Settings, if one is set). See dispatch:override in the permission catalog.
  maxBagsPerDispatch Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, category])
  @@index([customerId])
  @@map("customer_bag_weights")
}

// A per-customer logo restriction: the logo is NOT ALLOWED for the given category
// (or category + sub-category). Replaces SP_CATEGORY_LOGO / SP_SUBCATEGORY_LOGO.
model CustomerLogoRestriction {
  id          Int      @id @default(autoincrement())
  customerId  Int
  // 'CATEGORY' | 'SUBCATEGORY'.
  scope       String
  category    String
  subCategory String   @default("") // '' when scope = CATEGORY
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, scope, category, subCategory])
  @@index([customerId])
  @@map("customer_logo_restrictions")
}

/// Audit trail of GST / transport rate changes so past rates stay visible.
/// One row per change (old -> new). `kind` is 'GST' or 'TRANS'.
model RateHistory {
  id            Int      @id @default(autoincrement())
  kind          String
  customerName  String
  category      String
  type          String? // transport only
  transportName String? // transport only
  oldRate       Int?
  newRate       Int?
  changedByName String?
  changedAt     DateTime @default(now())

  @@index([kind, customerName, category])
  @@index([changedAt])
  @@map("rate_history")
}

// Per-customer, per-product-category GST rate.
model GstRate {
  id           Int      @id @default(autoincrement())
  customerId   Int?
  // Stable customer code (e.g. CUST-00001) — the fast link to the customer master.
  customerCode String?
  customerName String
  // Product category (legacy PCATEGORY), stored uppercase.
  category     String
  rate         Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([customerName, category])
  @@index([customerId])
  @@index([customerCode])
  @@map("gst_rates")
}

// Per-customer transport rate, keyed by category + type + transporter.
model TransRate {
  id            Int      @id @default(autoincrement())
  customerId    Int?
  // Stable customer code (e.g. CUST-00001) — the fast link to the customer master.
  customerCode  String?
  customerName  String
  category      String
  type          String
  transporterId Int?
  transportName String?
  rate          Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  transporter Transporter? @relation(fields: [transporterId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([customerCode])
  @@index([transporterId])
  @@map("trans_rates")
}

// ── Catalog: Products, Designs & Combinations ───────────────────────────────

model Product {
  id             Int      @id @default(autoincrement())
  // Auto-generated code (e.g. PRD-00001).
  code           String?  @unique
  category       String
  subCategory    String
  product        String
  size           Float?
  weight         Float?
  pcs            Float?
  rate           Float?
  // Active products show in the order item pickers; inactive ones are hidden but kept.
  active         Boolean  @default(true)
  // Whether this product appears on the customer Rate List.
  showOnRateList Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // A product is uniquely identified by category + sub-category + product + size.
  @@unique([category, subCategory, product, size])
  @@index([category])
  @@index([product])
  @@map("products")
}

model Design {
  id             Int      @id @default(autoincrement())
  // Auto-generated code (e.g. DSG-00001).
  code           String?  @unique
  category       String
  subCategory    String
  designType     String
  cost           Float?
  rate           Float?
  // Active designs show in the order item pickers; inactive ones are hidden but kept.
  active         Boolean  @default(true)
  // Whether this design appears on the customer Rate List.
  showOnRateList Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  combinationLinks CombinationDesign[]

  @@unique([category, subCategory, designType])
  @@index([category])
  @@map("designs")
}

// Lookup: maps a design-type code to one or more human-readable names.
// A single code can have several names (one-to-many), so the natural key is the
// (designType, designName) pair, not the code alone.
model DesignName {
  id         Int      @id @default(autoincrement())
  designType String
  designName String
  /// Path relative to the /uploads root, e.g. "design-names/<uuid>.jpg" — a
  /// reference photo so the right design is recognisable at a glance.
  photoPath  String?
  /// Same-origin URL the web app loads, e.g. "/api/uploads/design-names/<uuid>.jpg".
  photoUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([designType, designName])
  @@index([designType])
  @@map("design_names")
}

model Combination {
  id        Int      @id @default(autoincrement())
  // Auto-generated code (e.g. CMB-00001).
  code      String?  @unique
  // Display name, auto-built by joining the component design types (editable).
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  designLinks CombinationDesign[]

  @@map("combinations")
}

// A combination is built from one or more designs. The link lets us recompute
// the combination's cost/rate whenever a constituent design's cost changes.
model CombinationDesign {
  combinationId Int
  designId      Int

  combination Combination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  design      Design      @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@id([combinationId, designId])
  @@index([designId])
  @@map("combination_designs")
}

// ── Orders ──────────────────────────────────────────────────────────────────

/// A sales order header. One order has many line items.
model Order {
  id             Int       @id @default(autoincrement())
  // Auto-generated human-readable order number (e.g. ORD-00001).
  code           String?   @unique
  // Customer's purchase-order number (free text, optional).
  poNumber       String?
  customerId     Int?
  customerName   String
  agentName      String?
  category       String? // e.g. SALES
  orderDate      DateTime  @default(now())
  completionDate DateTime?
  completionDay  Int?
  priority       String? // URGENT / NORMAL
  status         String    @default("PENDING") // CONFIRMED / PENDING / CANCELLED
  ordType        String    @default("SALES ORDER")
  comment        String?
  userName       String?
  // Why the order was cancelled (chosen from the shared Cancellation Reasons list;
  // cancelNote holds the free-typed detail when the reason is "Others").
  cancelReason   String?
  cancelNote     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items OrderItem[]

  // Set when this order was created by converting a quotation.
  fromQuotation   Quotation? @relation("OrderFromQuotation")
  // Set when this order was PARKED by "Save as Quotation" (status QUOTED): the
  // quotation below is the live document, and converting it revives this order
  // rather than minting a second one. The reverse of fromQuotation.
  quotationSource Quotation? @relation("QuotationFromOrder")
  dispatches      Dispatch[]

  @@index([customerId])
  @@index([status])
  @@index([orderDate])
  @@map("orders")
}

/// A sales quotation — same shape as an order, with its own QUO-##### numbering
/// and a lifecycle: DRAFT/SENT → CONVERTED (to an order) or CANCELLED (with a
/// tracked reason for analysis).
model Quotation {
  id             Int       @id @default(autoincrement())
  code           String?   @unique // QUO-#####
  poNumber       String?
  customerId     Int?
  customerName   String
  agentName      String?
  category       String?
  quotationDate  DateTime  @default(now())
  completionDate DateTime?
  completionDay  Int?
  priority       String?
  status         String    @default("DRAFT") // DRAFT / SENT / CONVERTED / CANCELLED
  ordType        String    @default("QUOTATION")
  comment        String?
  userName       String?

  // "Sent to customer" tracking.
  sentAt     DateTime?
  sentByName String?

  // Conversion tracking — links to the order this quotation became.
  convertedOrderId Int?      @unique
  convertedOrder   Order?    @relation("OrderFromQuotation", fields: [convertedOrderId], references: [id])
  convertedAt      DateTime?
  // How it was converted: DIRECT (as-is) or EDITED (changed first).
  convertMode      String?

  // Set when this quotation was produced from a DRAFT order ("Save as
  // Quotation" in View Orders). That order is parked at status QUOTED so it
  // stops showing as an order, and convert() revives THAT order — same id, same
  // Order # — instead of creating a duplicate alongside it. Deleting or
  // cancelling this quotation puts the order back to DRAFT.
  sourceOrderId Int?   @unique
  sourceOrder   Order? @relation("QuotationFromOrder", fields: [sourceOrderId], references: [id])

  // Cancellation tracking — why it was cancelled, for analysis.
  cancelReason    String?
  cancelNote      String?
  cancelledAt     DateTime?
  cancelledByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items QuotationItem[]

  @@index([customerId])
  @@index([status])
  @@index([quotationDate])
  @@map("quotations")
}

/// A single line item on a quotation (mirrors OrderItem).
model QuotationItem {
  id          Int      @id @default(autoincrement())
  quotationId Int
  pCategory   String?
  subCategory String?
  product     String?
  design      String?
  productName String?
  designType  String?
  psize       Float?
  bags        Float?
  pcs         Float?
  gram        Float?
  box         Float?
  productRate Float?
  designRate  Float?
  rate        Float?
  calField    String?
  priority    String?
  ordType     String?
  comment     String?
  createdAt   DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

/// A single line item on an order (a product × design + quantities + rates).
model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int
  pCategory       String? // product category (GLASS / CUP / …)
  subCategory     String?
  product         String?
  design          String?
  productName     String? // composite display name (e.g. "10 PLAIN")
  designType      String?
  psize           Float?
  bags            Float?
  pcs             Float?
  gram            Float?
  box             Float?
  productRate     Float?
  designRate      Float?
  rate            Float? // total = productRate + designRate
  calField        String? // pricing unit: KGS / PCS
  priority        String? // URGENT / NORMAL (per line item)
  ordType         String? // order type (e.g. SALES ORDER)
  // Per-line status: CONFIRMED (active) or CANCELLED (kept for the record, excluded
  // from order totals and not dispatchable). Mirrors legacy ORDERTBL.STATUS.
  status          String   @default("CONFIRMED")
  comment         String?
  // Soft link to the bag Booking this line was converted from (null for normal lines).
  bookingId       Int?
  /// The quotation line this one was converted FROM. Set by quotations.convert();
  /// null for a line added straight to the order, or added after conversion —
  /// which is exactly what keeps a post-conversion addition out of the quotation.
  /// Edits to a linked line are mirrored back onto that quotation line.
  ///
  /// A SOFT link (no foreign key), like `bookingId` above: adding a real FK
  /// column to this table makes SQLite rewrite all of order_items, and a table
  /// rewrite is not worth the referential integrity on a link that is only ever
  /// read to find the quotation line to mirror onto.
  quotationItemId Int?
  // Set only when the MS Access import couldn't use the legacy ORDERTBL.ID as this
  // row's id (another row — usually a natively-created OrderItem whose Prisma
  // autoincrement id happened to land on the same number — already owns it).
  // importDispatch falls back to matching legacy DispatchTbl.OrdTrans against this
  // column when it doesn't match any row's real id, so those dispatches still
  // resolve to the correct (remapped) line instead of silently landing on whichever
  // unrelated item now owns the original legacy id.
  legacyItemId    Int?
  createdAt       DateTime @default(now())

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dispatches  Dispatch[]
  photos      OrderItemPhoto[]
  designTrack DesignTrackEntry?
  changes     OrderItemChange[]

  @@index([orderId])
  @@index([bookingId])
  @@index([legacyItemId])
  @@index([quotationItemId])
  @@map("order_items")
}

/// One field-level change to an order line, recorded whenever a line is edited,
/// added or removed after the order exists. Immutable: rows are only ever
/// inserted, so the trail survives even when the line itself is later deleted
/// (hence orderItemId is nullable and NOT cascaded).
///
/// `quotationId` is carried on the row so a quotation can show every change made
/// to the order it became — including changes to lines that have since been
/// removed — without walking the (possibly deleted) order line to get there.
model OrderItemChange {
  id              Int      @id @default(autoincrement())
  orderId         Int
  /// The line changed. Null once that line has been deleted.
  orderItemId     Int?
  /// The quotation (and line) this order line came from, when it came from one.
  quotationId     Int?
  quotationItemId Int?
  /// UPDATED / ADDED / REMOVED.
  kind            String
  /// Which field changed — '' for ADDED / REMOVED, which describe a whole line.
  field           String
  oldValue        String?
  newValue        String?
  /// Human label for the line, kept so a REMOVED row still reads meaningfully.
  itemLabel       String?
  changedByName   String?
  changedAt       DateTime @default(now())

  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([quotationId])
  @@index([orderItemId])
  @@map("order_item_changes")
}

/// Design Track's hand-entered processed ("Kalwat") quantity for one order line.
/// One row per line, created on first entry — lines never touched simply have no
/// row, which is what distinguishes "nothing processed yet" from "0 processed".
/// The Remaining figure is NOT stored: it is always bags - kalwat, derived on
/// read so it cannot fall out of step with an edited order.
model DesignTrackEntry {
  orderItemId Int      @id
  kalwat      Float?
  /// Who last typed a value, for the audit trail on a manual figure.
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("design_track_entries")
}

/// A photo attached to an order line (reference image, artwork, packing shot…).
/// The file lives on disk under the project's /uploads folder; only its path +
/// served URL are stored here. Visible/editable from Order, Order Modify and
/// Dispatch — all keyed on the same order line.
model OrderItemPhoto {
  id          Int      @id @default(autoincrement())
  orderItemId Int
  /// Path relative to the /uploads root, e.g. "order-items/<uuid>.jpg".
  path        String
  /// Same-origin URL the web app loads, e.g. "/api/uploads/order-items/<uuid>.jpg".
  url         String
  filename    String? // original upload name (for download / display)
  mimeType    String?
  size        Int? // bytes
  uploadedBy  String? // user name/email that uploaded it
  createdAt   DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_photos")
}

/// A single dispatch (shipment) of an order line — partial or full. The pending
/// quantity of a line = ordered − Σ(dispatched). Mirrors the legacy DispatchTbl.
model Dispatch {
  id          Int     @id @default(autoincrement())
  code        String? @unique // DSP-#####
  orderItemId Int
  orderId     Int
  orderCode   String? // the parent order's human code (snapshot)

  // Snapshot of the line at dispatch time.
  customerId   Int?
  customerName String
  agentName    String?
  category     String?
  pCategory    String?
  subCategory  String?
  product      String?
  productName  String?
  designType   String?
  psize        Float?
  priority     String?
  calField     String?
  ordType      String?
  productRate  Float?
  designRate   Float?
  rate         Float?

  // Dispatched quantities.
  bags Float?
  pcs  Float?
  gram Float?
  box  Float?

  dispatchStatus String   @default("PARTIAL") // PARTIAL / FULL
  dispatchDate   DateTime @default(now())
  comment        String?
  supItem        String?
  userName       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([orderId])
  @@index([dispatchStatus])
  // Speeds the Pending Challan list: default ordering is by dispatchDate, and the
  // most common filter is by customer — without these the query full-scans + sorts
  // every dispatch row on each request.
  @@index([dispatchDate])
  @@index([customerName, dispatchDate])
  @@map("dispatches")
}

// ── Challan / Tax-Invoice (legacy PendChallan + Form14) ───────────────────────
// A challan is a tax invoice built from one customer's dispatched-but-not-yet-
// challaned lines. Header (InvTbl) + items (ChallanTbl). Pricing engine (freight/
// packing/pouch/GST/half-bill/TCS) + PDF print land in Phase 2.
model Challan {
  id              Int       @id @default(autoincrement())
  // Human invoice number, e.g. "SSS/26-27/01" (legacy InvNo).
  code            String    @unique
  prefix          String?
  invDate         DateTime  @default(now())
  invTime         String?
  customerId      Int?
  customerName    String
  billingAddress  String?
  shippingAddress String?
  category        String?
  paymentTerm     Int?
  dueDate         DateTime?
  transName       String?
  // Charges & totals (computed by the Phase-2 pricing engine).
  packing         Float?
  freight         Float?
  pouch           Float?
  tcs             Float?
  // % used to compute `tcs` on SCRAP challans (Settings → SCRAP TCS Rate at save time).
  tcsPercent      Float?
  // TDS deducted at source (when the party is TDS-applicable): amount + the % used.
  tds             Float?
  tdsPercent      Float?
  tax             Float? // GST amount
  total           Float?
  b               Float? // billed portion
  c               Float? // balance (total - b)
  remarks         String?
  gst             Float? // GST rate %
  freightRate     Float?
  packingRate     Float?
  billingRate     Float?
  bpcRate         Float?
  noBill          Boolean   @default(false)
  transaction     String    @default("SALES INVOICE")
  // CONFIRMED / CANCELLED.
  challanStatus   String    @default("CONFIRMED")
  userName        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items ChallanItem[]

  commissionAccruals AgentCommissionAccrual[]

  @@index([customerName])
  @@index([invDate])
  // Used by the "un-challaned dispatch" subquery behind the Pending Challan list.
  @@index([challanStatus])
  @@map("challans")
}

// Gaps in a prefix/FY invoice-number series that were explicitly acknowledged
// ("dismissed") by an operator, so they stop showing on the Missing Challan
// list. recycledAt set = restored back onto the missing list.
model ChallanMissingLog {
  id         Int       @id @default(autoincrement())
  prefix     String
  fy         String
  invNo      Int
  // Why this number was skipped (e.g. "voided by hand", "duplicate order") —
  // required at dismiss time so it means something on the "Show Deleted Only" list.
  reason     String?
  deletedAt  DateTime  @default(now())
  recycledAt DateTime?

  @@index([prefix, fy])
  @@map("challan_missing_log")
}

model ChallanItem {
  id          Int      @id @default(autoincrement())
  challanId   Int
  // Source dispatch line (null/0 for SCRAP or manual rows). Plain int — used to
  // decide which dispatches are still "pending challan".
  dispatchId  Int?
  productName String?
  design      String?
  bags        Float?
  pcs         Float?
  kgs         Float?
  box         Float?
  unit        String?
  price       Float?
  amount      Float?
  pCategory   String?
  comment     String?
  userName    String?
  createdAt   DateTime @default(now())

  challan Challan @relation(fields: [challanId], references: [id], onDelete: Cascade)

  @@index([challanId])
  @@index([dispatchId])
  @@map("challan_items")
}

/// Credit Note header (legacy InvTblR). Kept in its own table — like the legacy —
/// so credit notes never count as pending sales. A CN posts a CREDIT NOTE ledger
/// row and clears opening balance → pending invoices FIFO → parks the rest as a
/// party advance. code = "CN/<n>". Debit Notes, by contrast, live in `Challan`
/// (prefix='DN', transaction='DEBIT NOTE') because a DN *is* a pending debit.
model CreditNote {
  id              Int       @id @default(autoincrement())
  code            String    @unique
  prefix          String    @default("CN")
  invDate         DateTime  @default(now())
  invTime         String?
  customerId      Int?
  customerName    String
  billingAddress  String?
  shippingAddress String?
  category        String?
  paymentTerm     Int?
  dueDate         DateTime?
  transName       String?
  packing         Float?
  freight         Float?
  pouch           Float?
  tax             Float? // GST amount
  total           Float?
  b               Float? // bank portion
  c               Float? // cash portion
  remarks         String?
  gst             Float? // GST rate %
  freightRate     Float?
  packingRate     Float?
  billingRate     Float?
  bpcRate         Float?
  noBill          Boolean   @default(false)
  status          String    @default("CREDIT NOTE")
  userName        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items CreditNoteItem[]

  @@index([customerName])
  @@index([customerId])
  @@index([invDate])
  @@map("credit_notes")
}

model CreditNoteItem {
  id           Int      @id @default(autoincrement())
  creditNoteId Int
  // Source dispatch line the return refers to (0/null for manual rows).
  dispatchId   Int?
  // Original sale invoice this line credits against (legacy ChallanTblR.[Ref InvNo]).
  refInvNo     String?
  productName  String?
  design       String?
  bags         Float?
  pcs          Float?
  kgs          Float?
  box          Float?
  unit         String?
  price        Float?
  amount       Float?
  pCategory    String?
  comment      String?
  userName     String?
  createdAt    DateTime @default(now())

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([creditNoteId])
  @@index([dispatchId])
  @@map("credit_note_items")
}

/// User-editable option lists (e.g. completion-day choices, order types),
/// grouped by `group`. Managed from the Settings page.
model OrderOption {
  id        Int      @id @default(autoincrement())
  group     String // COMPLETION_DAYS / ORDER_TYPE / …
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([group, value])
  @@index([group])
  @@map("order_options")
}

/// Singleton key/value app configuration (e.g. company name, company logo data URL).
model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_config")
}

/// CRM follow-up: one commitment to a party (delivery or payment). Carries a
/// promised date + a reminder loop that re-surfaces it until resolved.
model Followup {
  id                   Int       @id @default(autoincrement())
  kind                 String    @default("DELIVERY") // DELIVERY | PAYMENT
  customerId           Int?
  partyName            String // always set (free text when the customer isn't in the system)
  orderId              Int?
  orderCode            String?
  orderItemId          Int?
  itemText             String? // free item text when no linked order line
  title                String
  detail               String?
  stage                String? // POLISHING | SUPPLIER | DISPATCH | READY | free text
  priority             String    @default("NORMAL")
  status               String    @default("OPEN") // OPEN | DONE | CANCELLED
  promisedAt           DateTime?
  // Promise-to-pay amount (PAYMENT follow-ups): "party promised ₹X by promisedAt".
  promisedAmount       Float?
  // Reminder loop (fall back to CRM defaults when null).
  reminderIntervalMins Int?
  maxRemindersPerDay   Int?
  remindersToday       Int       @default(0)
  remindersDate        String? // yyyy-mm-dd the counter applies to (resets daily)
  nextRemindAt         DateTime?
  lastRemindedAt       DateTime?
  pushSentAt           DateTime? // set once a push has fired for the current due-cycle; cleared on re-promise/snooze/reopen
  // §8: a commitment made BY an agent ("I'll get you an RTGS instead"), and the
  // cheque it was about. Both optional — ordinary party follow-ups set neither.
  agentId              Int?
  agentName            String?
  chequeId             Int?
  createdByName        String?
  resolvedByName       String?
  resolvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  cheque    Cheque?                 @relation(fields: [chequeId], references: [id], onDelete: SetNull)
  logs      FollowupLog[]
  checklist FollowupChecklistItem[]
  items     FollowupItem[]

  @@index([status])
  @@index([kind])
  @@index([partyName])
  @@index([promisedAt])
  @@index([customerId])
  @@index([agentId])
  @@index([chequeId])
  @@map("followups")
}

/// One item (with quantities) covered by a follow-up — a follow-up can span
/// several order lines, each with its own bags/pcs/kgs/box to deliver or collect.
model FollowupItem {
  id          Int      @id @default(autoincrement())
  followupId  Int
  /// Optional link to the actual order line (free-text-only when null).
  orderItemId Int?
  orderCode   String?
  productName String?
  bags        Float?
  pcs         Float?
  kgs         Float?
  box         Float?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  followup Followup @relation(fields: [followupId], references: [id], onDelete: Cascade)

  @@index([followupId])
  @@map("followup_items")
}

/// A tick-off task on a follow-up. Added by typing or by voice (Gemini turns
/// spoken Hindi/English into short checklist items).
model FollowupChecklistItem {
  id         Int      @id @default(autoincrement())
  followupId Int
  text       String
  done       Boolean  @default(false)
  sortOrder  Int      @default(0)
  /// 'MANUAL' | 'VOICE' — how the item was added.
  source     String   @default("MANUAL")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  followup Followup @relation(fields: [followupId], references: [id], onDelete: Cascade)

  @@index([followupId])
  @@map("followup_checklist_items")
}

/// One timeline entry on a follow-up (a note / ack / snooze / re-promise).
model FollowupLog {
  id            Int       @id @default(autoincrement())
  followupId    Int
  kind          String    @default("NOTE") // NOTE | ACK | SNOOZE | PROMISE | STATUS
  note          String?
  stage         String?
  newPromisedAt DateTime?
  userName      String?
  createdAt     DateTime  @default(now())

  followup Followup @relation(fields: [followupId], references: [id], onDelete: Cascade)

  @@index([followupId])
  @@map("followup_logs")
}

/// A bag booking: a customer reserves quantity (bags + kgs) without naming items.
/// The rates are frozen at `bookingDate`; later it's converted into real order
/// lines (in parts). `rateSnapshot` captures the customer's special-rate rows at
/// booking time so the effective rate can be reproduced exactly on conversion.
model Booking {
  id              Int       @id @default(autoincrement())
  code            String?   @unique // BKG-00001
  customerId      Int?
  customerName    String
  agentName       String?
  category        String? // SALES etc.
  bookingDate     DateTime  @default(now()) // the rate-basis date
  bags            Float     @default(0) // total booked
  kgs             Float     @default(0) // total booked (weight)
  convertedBags   Float     @default(0) // drawn down by conversions
  convertedKgs    Float     @default(0)
  status          String    @default("OPEN") // OPEN | PARTIALLY_CONVERTED | CONVERTED | CANCELLED | PRECLOSED
  comment         String?
  orderId         Int? // the Order holding converted lines (created lazily)
  // JSON of the customer's { rates, logos } special-rate rows captured at booking.
  rateSnapshot    String?
  userName        String?
  // Preclose: writes off whatever was still pending on a PARTIALLY_CONVERTED
  // booking and closes it for good — the qty written off (as of that moment) is
  // captured here so it isn't just silently dropped. Null until preclosed.
  precloseBags    Float?
  precloseKgs     Float?
  precloseComment String?
  precloseByName  String?
  precloseAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  conversions BookingConversion[]
  items       BookingItem[]

  @@index([customerId])
  @@index([status])
  @@index([bookingDate])
  @@map("bookings")
}

/// One product-category line reserved on a booking (e.g. "1 bag GLASS"). A
/// booking's own bags/kgs are the rollup sum of its items. Matched against real
/// OrderItem.pCategory at conversion time to draw down per-category, not just
/// the booking's overall total.
model BookingItem {
  id            Int      @id @default(autoincrement())
  bookingId     Int
  pCategory     String
  bags          Float    @default(0)
  kgs           Float    @default(0)
  convertedBags Float    @default(0)
  convertedKgs  Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_items")
}

/// Audit of one conversion step: which items were pulled from a booking, the
/// booking-date rate used, and the order line created.
model BookingConversion {
  id              Int       @id @default(autoincrement())
  bookingId       Int
  // Unique (not just indexed): an OrderItem is drawn from at most one booking
  // ever, so this is a stable 1:1 handle recompute() upserts against instead of
  // deleting/recreating the row — which is what lets `removedAt` below survive
  // across repeated recomputes instead of being wiped every time.
  orderItemId     Int?      @unique
  productName     String?
  designType      String?
  bags            Float?
  kgs             Float?
  pcs             Float?
  box             Float?
  frozenRate      Float? // the effective rate as of the booking date
  amount          Float?
  convertedByName String?
  convertedAt     DateTime  @default(now())
  // Snapshot of the order the line landed on, captured at every recompute —
  // survives even if the Order (or just this line) is later hard-deleted, which
  // is the only case `orderItemId`'s own join can no longer resolve.
  orderId         Int?
  orderCode       String?
  orderDate       DateTime?
  // Set once this line stops counting toward Booking.convertedBags/Kgs — i.e. it
  // (or its whole order) was cancelled, or the OrderItem row itself was deleted
  // outright. Frozen at the moment it happens (recompute() never pushes it
  // forward on a later, unrelated call) so the PDF can show exactly how this
  // qty was used before it stopped counting.
  removedAt       DateTime?
  // LINE_CANCELLED | ORDER_CANCELLED | LINE_DELETED
  removedReason   String?
  removedByName   String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_conversions")
}

/// Every change to a product's chart rate (old -> new). Powers "rate as of date"
/// for bag-booking conversion + an auditable price-change trail.
model ProductRateHistory {
  id            Int      @id @default(autoincrement())
  productId     Int
  productName   String
  category      String
  subCategory   String
  size          Float?
  oldRate       Float?
  newRate       Float?
  changedByName String?
  changedAt     DateTime @default(now())

  @@index([productId])
  @@index([changedAt])
  @@map("product_rate_history")
}

/// Every change to a design's rate (old -> new).
model DesignRateHistory {
  id            Int      @id @default(autoincrement())
  designId      Int
  designType    String
  category      String
  subCategory   String
  oldRate       Float?
  newRate       Float?
  changedByName String?
  changedAt     DateTime @default(now())

  @@index([designId])
  @@index([changedAt])
  @@map("design_rate_history")
}

/// Every change to a per-customer special-rate override (old -> new; null = removed).
model CustomerRateHistory {
  id            Int      @id @default(autoincrement())
  customerId    Int
  customerName  String?
  kind          String // PRODUCT | DESIGN
  scope         String
  category      String
  subCategory   String
  target        String
  oldRate       Float?
  newRate       Float?
  changedByName String?
  changedAt     DateTime @default(now())

  @@index([customerId])
  @@index([changedAt])
  @@map("customer_rate_history")
}

// ── Accounts: Cheque management ─────────────────────────────────────────────

/// Company bank accounts (legacy SETTING_BANK_NAME). The Manage Cheques form's
/// "deposit bank" picker shows "BANK NAME-<last 4 of A/C>".
model BankAccount {
  id        Int      @id @default(autoincrement())
  bankName  String
  acNo      String
  ifsc      String?
  branch    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bankName, acNo])
  @@map("bank_accounts")
}

/// A received cheque and its lifecycle (legacy ACCT MANAGE CHEQUE):
/// PENDING → DEPOSITED → CLEARED | BOUNCED. Deposit is only allowed on/after the
/// due date. A bounced cheque may be re-deposited (isRepresent).
model Cheque {
  id               Int       @id @default(autoincrement())
  // Snapshot of the party + FK to the customer (legacy CUS ID).
  customerId       Int?
  partyName        String
  chequeNo         String
  chequeAmt        Float
  // Party's/payer's bank (free text) and our deposit bank ("BANK NAME-1234").
  payeeBank        String?
  drawerBank       String?
  recDate          DateTime  @default(now())
  dueDate          DateTime
  depositDate      DateTime?
  // Clear/bounce (account transaction) date.
  acctTransDate    DateTime?
  bounceCharges    Float?
  // SELF | PARTY (only when bounced).
  chargesPaidBy    String?
  // Bounced cheque being re-deposited (legacy IS CHEQUE REPRESENT).
  isRepresent      Boolean   @default(false)
  comments         String?
  // JSON-encoded array of invoice/challan codes this cheque is meant to clear
  // (e.g. '["SSS/26-27/362","SSS/26-27/365"]'), null when none were tagged.
  invoiceNos       String?
  // The agent who physically brought this cheque in, when one did (§6). Party
  // cheques handed over directly leave this null — which is also what decides
  // whether a bounce charge is proposed against an agent at settlement.
  agentId          Int?
  agentName        String?
  // Set when this cheque REPLACES a bounced one (§12), so the full story —
  // original, its bounces, the replacement, the eventual clearance — stays
  // walkable in either direction.
  replacesChequeId Int?
  // PENDING | DEPOSITED | CLEARED | BOUNCED.
  status           String    @default("PENDING")
  userName         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  agent        Agent?              @relation(fields: [agentId], references: [id], onDelete: SetNull)
  replaces     Cheque?             @relation("ChequeReplacement", fields: [replacesChequeId], references: [id], onDelete: SetNull)
  replacedBy   Cheque[]            @relation("ChequeReplacement")
  bounceEvents ChequeBounceEvent[]
  followups    Followup[]

  @@index([status])
  @@index([dueDate])
  @@index([customerId])
  @@index([chequeNo])
  @@index([agentId])
  @@map("cheques")
}

// ── Accounts: Receivables subledger (Payment / Opening Balance) ──────────────
// Ported from the legacy PaymentForm accounting tables. Invoices being paid are
// CONFIRMED challans (b = bank/billed portion, c = cash portion). The three legacy
// "…Summary" Access views are computed in the service layer as aggregations of
// these tables (a challan's pending = b/c minus the receipts allocated to it; an
// advance's balance = its amount minus receipts that reference it; opening pending
// = opening entries minus opening clearances).

/// Master ledger — one row per receipt voucher (legacy ACCT LEDGER). Voucher no is
/// RN/<serial> (agent) or R/<serial> style; source of the running voucher number.
model AcctLedger {
  id                Int       @id @default(autoincrement())
  voucherNo         String
  transDate         DateTime
  customerName      String
  custId            Int       @default(0)
  agentName         String?
  particulars       String?
  voucherType       String    @default("RECEIPT")
  transMode         String // BANK | CHEQUE | CASH
  bankDebit         Float     @default(0)
  cashDebit         Float     @default(0)
  bankCredit        Float     @default(0)
  cashCredit        Float     @default(0)
  transRemarks      String?
  userName          String?
  // The full original save() input (RECEIPT vouchers only) — captured so this
  // voucher, and anything saved after it, can be reversed and replayed if its
  // amount/date/mode needs correcting. Null on vouchers saved before edit
  // support existed; those can't be edited (see PaymentsService.editReceipt).
  adjMode           String?
  selectedInvNos    String? // JSON array — AGST REF mode only
  takeAccOn         String? // PARTY | AGENT
  bankName          String?
  chequeNo          String?
  cashTransLocation String?
  cashRecBy         String?
  // This voucher's own generated REC-.../ADV-... ids (if any were created) —
  // reused verbatim on replay so later vouchers that reference them still resolve.
  receiptRefId      String?
  advanceRefId      String?
  editedAt          DateTime?
  editedByName      String?
  createdAt         DateTime  @default(now())

  @@index([custId])
  @@index([voucherNo])
  @@index([transDate])
  @@map("acct_ledger")
}

/// Receipt allocation lines (legacy ACCT PAYMENT RECEIPT). One row per (invoice,
/// funding source). refRecId links to the voucher (fresh receipt) or to an advance
/// REF ID (when an old advance funded the allocation). modeOfAdj = AUTOMATIC/AGST
/// REF/ADVANCE.
model AcctPaymentReceipt {
  id                Int      @id @default(autoincrement())
  refId             String
  recDate           DateTime
  invNo             String
  customerName      String
  custId            Int
  recType           String   @default("RECEIPT")
  recAmt            Float
  payMode           String
  bankName          String?
  chequeNo          String?
  cashTransLocation String?
  cashRecBy         String?
  modeOfAdj         String?
  // Voucher no (fresh receipt) OR advance REF ID (advance-funded allocation).
  refRecId          String?
  // The voucher whose save() call created this row — independent of refRecId
  // (which records who FUNDED it). The reliable key for "everything voucher X
  // touched," used to reverse/replay a voucher when its amount is edited.
  sourceVoucherNo   String?
  createdAt         DateTime @default(now())

  @@index([custId])
  @@index([invNo])
  @@index([refRecId])
  @@index([recDate])
  @@index([sourceVoucherNo])
  @@map("acct_payment_receipt")
}

/// On-account / advance balances (legacy ACCT PARTY ADVANCE). Consumed FIFO by
/// receipts whose refRecId = this refId. takeAccOn = PARTY | AGENT.
model AcctPartyAdvance {
  id                Int      @id @default(autoincrement())
  refId             String
  recDate           DateTime
  custId            Int
  customerName      String
  agentName         String?
  bankAmt           Float    @default(0)
  cashAmt           Float    @default(0)
  payMode           String
  bankName          String?
  chequeNo          String?
  cashTransLocation String?
  cashRecBy         String?
  recType           String   @default("RECEIPT")
  // Originating voucher no.
  refRecId          String?
  takeAccOn         String? // PARTY | AGENT
  // The voucher whose save() call created this row — see AcctPaymentReceipt.sourceVoucherNo.
  sourceVoucherNo   String?
  createdAt         DateTime @default(now())

  @@index([custId])
  @@index([refId])
  @@index([recDate])
  @@index([sourceVoucherNo])
  @@map("acct_party_advance")
}

/// Opening balances + their clearances (legacy ACCT OPENING TRANS). kind = OPENING
/// (entered on the Opening Balance form, with drCr = DEBIT/CREDIT) or CLEARANCE
/// (written when a receipt clears opening pending, linked via refRecId = voucher).
/// A DEBIT opening = customer owes us (cleared by receipts); CREDIT = we owe them.
model AcctOpeningTrans {
  id              Int      @id @default(autoincrement())
  kind            String   @default("OPENING") // OPENING | CLEARANCE
  customerName    String
  custId          Int
  transDate       DateTime
  bankAmt         Float    @default(0)
  cashAmt         Float    @default(0)
  drCr            String? // DEBIT | CREDIT (OPENING rows only)
  // Voucher no that cleared this opening (CLEARANCE rows only).
  refRecId        String?
  // The voucher whose save() call created this row — see AcctPaymentReceipt.sourceVoucherNo.
  sourceVoucherNo String?
  remarks         String?
  userName        String?
  createdAt       DateTime @default(now())

  @@index([custId])
  @@index([kind])
  @@index([transDate])
  @@index([sourceVoucherNo])
  @@map("acct_opening_trans")
}

/// Sales discount granted against a pending invoice (legacy ACCT PARTY DISCOUNT).
/// Reduces the invoice's BANK (b) or CASH (c) outstanding, exactly like a receipt:
/// pending = amount − Σ(receipts) − Σ(discounts). Each save also posts a matching
/// SALES DISCOUNT voucher (SD/<id>) to AcctLedger as a credit on the mode's bucket.
model AcctPartyDiscount {
  id           Int      @id @default(autoincrement())
  disDate      DateTime
  invNo        String
  customerName String
  custId       Int
  // Snapshot of the invoice's B (BANK) or C (CASH) amount at discount time.
  invAmt       Float    @default(0)
  disAmt       Float
  // BANK | CASH — which bucket this discount settles.
  billType     String
  // Linked ledger voucher (SD/<id>); kept so edit/delete can update/remove it.
  voucherNo    String?
  userName     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([invNo])
  @@index([custId])
  @@index([billType])
  @@map("acct_party_discount")
}

/// Universal approval inbox.
///
/// One row per action that a user was NOT allowed to perform outright and which
/// therefore needs an admin sign-off. The pending action is stored here as a JSON
/// `payload` and is only replayed against the real tables once it is approved —
/// nothing half-made is written into the operational data, so no other query in
/// the system has to learn to filter out "not yet approved" records.
///
/// First user: a dispatch entered with a date other than today by someone without
/// `dispatch:approve`. Approving it creates the Dispatch exactly as if the user
/// had had the right; rejecting it leaves no trace beyond this row.
///
/// `type` is an open string so new approval kinds can be added without a
/// migration; see APPROVAL_TYPES in @oms/shared for the ones handled today.
model ApprovalRequest {
  id     Int     @id @default(autoincrement())
  code   String? @unique // APR-#####
  type   String
  status String  @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED

  /// One-line heading for the inbox row (e.g. "Back-dated dispatch — ACME LTD").
  title   String
  /// Supporting detail shown under the title.
  summary String?
  /// JSON body replayed verbatim on approval. Shape depends on `type`.
  payload String

  /// What the request is about, for display/linking (e.g. 'Order', 1234).
  entity   String?
  entityId Int?

  // User.id is a cuid STRING, not an int — these were previously Int? and so
  // silently stored null for every request.
  requestedById   String?
  requestedByName String?
  requestedAt     DateTime @default(now())

  decidedById   String?
  decidedByName String?
  decidedAt     DateTime?
  /// Approver's note, and the reason shown to the requester on a rejection.
  decisionNote  String?

  /// Id of whatever the approval created (e.g. the new Dispatch), for traceability.
  resultId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, type])
  @@index([requestedAt])
  @@map("approval_request")
}

/// ── Tally reconciliation ──────────────────────────────────────────────────
/// Compares an uploaded Tally ledger register (Sundry Debtors, BANK entries
/// only) against what OMS holds, so data-entry gaps on either side surface.

/// A Tally ledger name that doesn't equal an OMS party name, pinned to the
/// customer it really is. Built once by the user and reused by every later
/// upload, because Tally spellings drift ("CHAITNYA" vs "CHAITANYA").
model TallyPartyAlias {
  id         Int      @id @default(autoincrement())
  /// Ledger name exactly as it appears in the register.
  tallyName  String   @unique
  customerId Int
  createdAt  DateTime @default(now())
  createdBy  String?

  @@map("tally_party_alias")
}

/// One upload + its computed result, kept so a reconciliation can be reopened
/// and used as evidence of what was checked when.
model TallyReconRun {
  id         Int      @id @default(autoincrement())
  fileName   String
  /// Period the register covers, read from its own header.
  fromDate   DateTime
  toDate     DateTime
  uploadedAt DateTime @default(now())
  userName   String?

  /// Headline counters, so the runs list needn't re-aggregate the rows.
  ledgerCount          Int @default(0)
  voucherCount         Int @default(0)
  matchedCount         Int @default(0)
  missingInOms         Int @default(0)
  missingInTally       Int @default(0)
  mismatchCount        Int @default(0)
  unmatchedParty       Int @default(0)
  /// How many flagged lines the user has marked. Kept on the run so the history
  /// list can show review progress without loading every row.
  pendingCount         Int @default(0)
  solvedCount          Int @default(0)
  /// Parties whose closing balance disagrees with the register.
  balanceMismatchCount Int @default(0)
  balanceCheckedCount  Int @default(0)

  rows     TallyReconRow[]
  balances TallyReconBalance[]

  @@index([uploadedAt])
  @@map("tally_recon_run")
}

/// One compared line. Rows sourced from TALLY carry what the register said;
/// rows sourced from OMS are the ones the register never mentioned.
model TallyReconRow {
  id    Int           @id @default(autoincrement())
  runId Int
  run   TallyReconRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// TALLY | OMS — which side this line came from.
  source       String
  ledgerName   String
  customerId   Int?
  customerName String?
  txnDate      DateTime
  /// OPENING | SALES | RECEIPT | CREDIT NOTE | DEBIT NOTE | DISCOUNT | OTHER
  vchType      String
  vchNo        String
  particulars  String?
  /// Bank-leg figures only, which is all the register carries.
  dr           Float    @default(0)
  cr           Float    @default(0)

  /// MATCHED | MISSING_IN_OMS | MISSING_IN_TALLY | AMOUNT_MISMATCH |
  /// DATE_MISMATCH | UNMATCHED_PARTY | NOT_APPLICABLE
  status    String
  /// The OMS voucher this line was matched to, and its figures, when matched.
  omsRef    String?
  omsAmount Float?
  omsDate   DateTime?
  note      String?

  /// Set when the user creates the missing entry straight from the report.
  resolvedAt  DateTime?
  resolvedRef String?

  /// The user's own review of this discrepancy: OPEN (untouched) | PENDING |
  /// SOLVED. A mark never suppresses the row — it still counts as a problem —
  /// it records what the user has done about it.
  review     String    @default("OPEN")
  reviewNote String?
  reviewedAt DateTime?
  reviewedBy String?

  /// Stable identity for "the same discrepancy" across uploads, so a mark made
  /// on one register carries onto the next one that still reports it.
  issueKey String

  @@index([runId])
  @@index([runId, status])
  @@index([runId, vchType])
  @@index([runId, review])
  @@index([issueKey])
  @@map("tally_recon_row")
}

/// Per-party closing-balance comparison for one run.
///
/// The row-by-row report says which vouchers disagree; this says whether the
/// party's *balance* agrees, and if not, how far back the agreement survived.
/// The useful checkpoint is the last receipt the user recorded: if both sides
/// still agree there, then everything that went wrong happened after it.
model TallyReconBalance {
  id    Int           @id @default(autoincrement())
  runId Int
  run   TallyReconRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  ledgerName   String
  customerId   Int?
  customerName String?

  /// Signed, Dr positive. Bank leg only — all the register carries.
  tallyOpening Float   @default(0)
  omsOpening   Float   @default(0)
  tallyClosing Float   @default(0)
  omsClosing   Float   @default(0)
  /// tallyClosing − omsClosing.
  difference   Float   @default(0)
  matched      Boolean @default(false)

  /// Latest OMS receipt in the period, and both balances as at that date.
  lastReceiptDate     DateTime?
  lastReceiptRef      String?
  tallyAtLastReceipt  Float?
  omsAtLastReceipt    Float?
  agreedAtLastReceipt Boolean?

  /// First date the two running balances part company (null when they never do).
  firstDivergenceOn        DateTime?
  /// True when the divergence begins only after the last recorded receipt.
  divergedAfterLastReceipt Boolean   @default(false)

  @@index([runId])
  @@index([runId, matched])
  @@map("tally_recon_balance")
}

/// A review mark that outlives the run it was made on.
///
/// Recon rows are rewritten wholesale on every upload, so the marks live here
/// keyed by `issueKey` and are re-applied to any new row describing the same
/// discrepancy. Fixing something for real makes it stop being reported at all,
/// which is what retires a mark — nothing needs to delete it.
model TallyReconMark {
  id       Int    @id @default(autoincrement())
  issueKey String @unique

  /// PENDING | SOLVED. Clearing a mark deletes the row rather than storing OPEN.
  review     String
  note       String?
  reviewedAt DateTime @default(now())
  reviewedBy String?

  /// Denormalised so the mark is legible on its own.
  ledgerName String
  vchType    String
  vchNo      String

  @@index([review])
  @@map("tally_recon_mark")
}

// ── Agent commission, cheque bounce history & settlement ────────────────────
// A self-contained subsystem: nothing here writes to the party's own accounting
// tables (AcctPaymentReceipt / AcctLedger). That separation is a hard rule —
// section 5 of the process doc requires a party's outstanding to stay
// outstanding even when the AGENT has personally covered it.

/// What an agent earns per kg, per product category. Date-effective rather than
/// a single mutable number: a settlement run months later must price an invoice
/// with the rate that applied when it was raised, not today's.
model AgentCommissionRate {
  id            Int      @id @default(autoincrement())
  agentId       Int
  agentName     String
  /// Product category as it appears on a challan LINE (ChallanItem.pCategory,
  /// e.g. "GLASS") — not the customer category on the challan header.
  pCategory     String
  /// KGS or PCS — categories are priced by weight or by piece, and commission
  /// follows the same unit the product master already uses for that category.
  basis         String   @default("KGS")
  ratePerUnit   Float
  effectiveFrom DateTime
  note          String?
  userName      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, pCategory, effectiveFrom])
  @@map("agent_commission_rates")
}

/// An override of an agent's base commission rate, aimed at one party, category,
/// sub-category, product or design.
///
/// A REPLACEMENT rate, not a delta: commission is a whole number per unit, so
/// two matching rules could never be added together. Exactly one wins, chosen
/// most-specific-first with a party-specific rule outranking a general one — see
/// `resolveCommissionRate` in @oms/shared, which is the single definition of
/// that precedence and is used by both the accrual engine and the UI's tester.
///
/// Every narrowing column is nullable so one table expresses all five scopes;
/// `scope` records which of them the rule was AIMED at, so a rule can never be
/// silently reinterpreted as a broader one by a later edit that clears a column.
model AgentSpecialCommission {
  id            Int      @id @default(autoincrement())
  agentId       Int
  agentName     String
  /// CUSTOMER | CATEGORY | SUBCATEGORY | PRODUCT | DESIGN
  scope         String
  /// Null = not tied to one party (applies across this agent's parties).
  customerId    Int?
  customerName  String?
  /// Challan LINE category (ChallanItem.pCategory), as for the base rate.
  pCategory     String?
  subCategory   String?
  product       String?
  designType    String?
  /// Kept for display and for a rule created before its category had a basis;
  /// the CATEGORY's basis wins when the two disagree, since the basis decides
  /// the quantity and a special only ever decides the rate.
  basis         String   @default("KGS")
  ratePerUnit   Float
  effectiveFrom DateTime
  note          String?
  userName      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, effectiveFrom])
  @@index([agentId, customerId])
  @@map("agent_special_commissions")
}

/// Gross commission one invoice generated for an agent, split by category.
/// This is the ENTITLEMENT, not the payable: how much is actually due depends on
/// how much of the invoice the party has paid (pro-rata), which is resolved at
/// settlement time so a later payment automatically increases what is payable.
model AgentCommissionAccrual {
  id           Int       @id @default(autoincrement())
  agentId      Int
  agentName    String
  challanId    Int
  invNo        String
  customerId   Int?
  customerName String
  pCategory    String
  /// KGS or PCS, copied from the rate in force when this was accrued.
  basis        String    @default("KGS")
  /// The quantity actually charged on — kilos or pieces, per `basis`.
  qty          Float
  /// Both totals are kept whatever the basis, so a figure can be checked
  /// against the invoice without re-reading the challan lines.
  kgs          Float
  pcs          Float     @default(0)
  /// The rate the money was calculated at. When the invoice's lines in this
  /// category priced at DIFFERENT rates (a special aimed at one product, say),
  /// this is the BLENDED rate — amount ÷ qty — so `qty × ratePerUnit` still
  /// equals `amount` exactly for every consumer that recomputes it.
  ///
  /// Splitting the row per rate was the alternative and is not possible: the
  /// unique key below, the settled-share map and the settlement lines all
  /// identify an accrual by (invoice, category), so a second row for the same
  /// pair would double-count against itself.
  ratePerUnit  Float
  amount       Float
  /// Which rule priced this — "Base rate", "Product BREZZA · ANIL METAL", or
  /// "blended (n rules)". Audit only; nothing computes from it. Without it a
  /// figure derived from a special rate cannot be traced back to the rule that
  /// set it, which is precisely the figure someone will question.
  rateNote     String?
  invDate      DateTime
  /// Copied from the challan so overdue can be judged without re-joining, and
  /// stays correct even if the party's credit period is edited later.
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  challan Challan @relation(fields: [challanId], references: [id], onDelete: Cascade)

  @@unique([challanId, pCategory])
  @@index([agentId])
  @@index([invNo])
  @@map("agent_commission_accruals")
}

/// Section 5 — the agent personally covered a defaulting party's amount.
///
/// Deliberately NOT a payment: nothing here reduces the party's outstanding, so
/// the party ledger keeps showing the money as receivable exactly as before.
/// When the party eventually does pay, status moves to RECOVERED and the agent
/// is reimbursed — which is why the link to the party and invoice is kept.
model AgentPartyCover {
  id           Int       @id @default(autoincrement())
  agentId      Int
  agentName    String
  customerId   Int?
  customerName String
  /// The bill this covers, when it was for a specific one.
  invNo        String?
  amount       Float
  /// CASH | BANK — how the agent handed it over. COMMISSION_ADJUST when the
  /// agent asked for it to come off his commission instead of paying it in.
  mode         String
  coveredAt    DateTime
  remarks      String?
  /// OPEN | RECOVERED | WRITTEN_OFF
  status       String    @default("OPEN")
  recoveredAt  DateTime?
  /// How it came back — a party receipt voucher no, or a settlement code.
  recoveredVia String?
  userName     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([customerId])
  @@index([status])
  @@map("agent_party_covers")
}

/// Sections 9-11 — one row per actual bounce. The same cheque can be deposited
/// and bounce any number of times, and each attempt carries its own charge, so
/// this cannot be a column on Cheque (which held a single bounceCharges float).
model ChequeBounceEvent {
  id          Int      @id @default(autoincrement())
  chequeId    Int
  bounceDate  DateTime
  /// Our bank that levied the charge — the rate comes from BankBounceCharge.
  bankName    String?
  charge      Float    @default(0)
  gstPercent  Float    @default(0)
  /// charge + GST, stored rather than derived so a later change to the bank's
  /// configured rate cannot silently rewrite what was actually charged.
  totalCharge Float    @default(0)
  reason      String?
  /// Photograph of the bank's bounce memo (section 11) — the proof if an agent
  /// later disputes the deduction. Uploaded from the phone like dispatch photos.
  receiptUrl  String?
  receiptPath String?
  userName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cheque Cheque @relation(fields: [chequeId], references: [id], onDelete: Cascade)

  @@index([chequeId])
  @@index([bounceDate])
  @@map("cheque_bounce_events")
}

/// Section 10 — bounce charge per bank of ours (e.g. Axis 100 + 18% GST = 118).
/// Applies to agent- and party-provided cheques alike.
model BankBounceCharge {
  id         Int      @id @default(autoincrement())
  bankName   String   @unique
  charge     Float    @default(0)
  gstPercent Float    @default(18)
  userName   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("bank_bounce_charges")
}

/// Sections 3 and 13 — one settlement run: gross commission, what was taken off,
/// and the net handed over. DRAFT while the owner is still deciding rates and
/// deductions; PAID freezes it as the record of what was actually settled.
model AgentSettlement {
  id              Int       @id @default(autoincrement())
  code            String?   @unique
  agentId         Int
  agentName       String
  /// Which invoices' payments this run covers.
  periodFrom      DateTime
  periodTo        DateTime
  grossCommission Float     @default(0)
  bounceDeduction Float     @default(0)
  coverDeduction  Float     @default(0)
  otherDeduction  Float     @default(0)
  /// CASH | BANK. TDS applies to BANK only (section 3).
  payMode         String?
  tdsPercent      Float     @default(0)
  tdsAmount       Float     @default(0)
  netPayable      Float     @default(0)
  /// DRAFT | PAID | CANCELLED
  status          String    @default("DRAFT")
  paidAt          DateTime?
  remarks         String?
  userName        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  agent      Agent                      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lines      AgentSettlementLine[]
  deductions AgentSettlementDeduction[]

  @@index([agentId])
  @@index([status])
  @@map("agent_settlements")
}

/// One invoice inside a settlement. Keeps BOTH the configured rate and the rate
/// the owner actually applied (section 4) — an overdue party can be settled at
/// 20/kg against a 40/kg master rate, and the pair plus the reason is what makes
/// that decision explainable months later.
model AgentSettlementLine {
  id                 Int      @id @default(autoincrement())
  settlementId       Int
  challanId          Int?
  invNo              String
  customerName       String
  pCategory          String
  /// KGS or PCS — what `qty` and the rates below are counted in.
  basis              String   @default("KGS")
  qty                Float
  baseRatePerUnit    Float
  appliedRatePerUnit Float
  /// The share of the invoice THIS LINE pays commission on — not the invoice's
  /// running total. On a first settlement they're the same; on a top-up this is
  /// only the extra collected since. Summing it across paid lines is how the
  /// engine knows what's still claimable.
  paidRatio          Float    @default(0)
  invoiceAmount      Float    @default(0)
  paidAmount         Float    @default(0)
  amount             Float    @default(0)
  /// This line is the balance on an invoice settled earlier at a lower
  /// collection level, kept so the payout can be explained months later.
  isTopUp            Boolean  @default(false)
  /// What had already been commissioned on the invoice before this line.
  priorSettledRatio  Float    @default(0)
  /// Why the owner moved off the configured rate, when they did.
  reason             String?
  createdAt          DateTime @default(now())

  settlement AgentSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@map("agent_settlement_lines")
}

/// A single deduction on a settlement — a bounce charge pulled from Cheque
/// Management, an agent-cover being recouped, or a manual entry. Each keeps a
/// pointer back to what it came from so the deduction can be justified (13).
model AgentSettlementDeduction {
  id            Int       @id @default(autoincrement())
  settlementId  Int
  /// BOUNCE | COVER | MANUAL
  kind          String
  bounceEventId Int?
  coverId       Int?
  chequeNo      String?
  bankName      String?
  refDate       DateTime?
  amount        Float
  note          String?
  createdAt     DateTime  @default(now())

  settlement AgentSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@map("agent_settlement_deductions")
}
